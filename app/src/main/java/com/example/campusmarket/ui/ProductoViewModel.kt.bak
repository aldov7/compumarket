package com.campusmarket.ui

import android.app.Application
import androidx.lifecycle.AndroidViewModel
import androidx.lifecycle.viewModelScope
import com.campusmarket.data.*
import kotlinx.coroutines.flow.*
import kotlinx.coroutines.launch

class ProductoViewModel(app: Application) : AndroidViewModel(app) {
    private val dao = AppDatabase.getDatabase(app).productoDao()

    // Estado de la lista de productos
    val productos: StateFlow<List<Producto>> = dao.obtenerTodos()
        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5000), emptyList())

    fun guardar(producto: Producto) = viewModelScope.launch {
        if (producto.id == 0) dao.insertar(producto) else dao.actualizar(producto)
    }

    fun eliminar(producto: Producto) = viewModelScope.launch { dao.eliminar(producto) }
}