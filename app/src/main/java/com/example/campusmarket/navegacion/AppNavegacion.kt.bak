package com.example.campusmarket.navegacion

import androidx.compose.runtime.Composable
import androidx.lifecycle.viewmodel.compose.viewModel
import androidx.navigation.NavType
import androidx.navigation.compose.*
import androidx.navigation.navArgument
import com.campusmarket.ui.*

@Composable
fun AppNavegacion() {
    val nav = rememberNavController()
    val vm: ProductoViewModel = viewModel()

    NavHost(navController = nav, startDestination = "principal") {
        composable("principal") {
            PantallaPrincipal(
                vm = vm,
                onAgregar = { nav.navigate("formulario/0") },
                onDetalle = { id -> nav.navigate("detalle/$id") }
            )
        }
        composable(
            "formulario/{id}",
            arguments = listOf(navArgument("id") { type = NavType.IntType })
        ) { entry ->
            PantallaFormulario(
                vm = vm,
                productoId = entry.arguments?.getInt("id") ?: 0,
                onVolver = { nav.popBackStack() }
            )
        }
        composable(
            "detalle/{id}",
            arguments = listOf(navArgument("id") { type = NavType.IntType })
        ) { entry ->
            PantallaDetalle(
                vm = vm,
                productoId = entry.arguments?.getInt("id") ?: 0,
                onEditar = { id -> nav.navigate("formulario/$id") },
                onVolver = { nav.popBackStack() }
            )
        }
    }
}